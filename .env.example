# Adopt API Credentials
# Get these from: https://www.adopt.ai → Settings → Profile → Personal Tokens
ADOPT_CLIENT_ID=your_client_id_here
ADOPT_CLIENT_SECRET=your_client_secret_here

# Adopt API Endpoint (usually no need to change)
ADOPT_API_ENDPOINT=https://connect.adopt.ai

# Optional: Groq API Key for LLM Enhancement
# Get free key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here